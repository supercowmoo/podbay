#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
source "$script_dir/../lib/repo-key.sh"
source "$script_dir/../lib/mounts.sh"
source "$script_dir/../lib/volumes.sh"
source "$script_dir/../lib/profile-image.sh"

usage() {
  cat <<'EOF'
usage: podbay --project <path> [--profile <name>] [--local-cache] [--list-profiles] [--init-profile <name>] [--help]

  --project <path>        repo to mount at /home/dev/workspace/repomount (required)
  --profile <name>        select ~/.config/podbay/profiles/<name> (default: common only)
  --local-cache           use per-repo mise cache at ~/.cache/podbay/mise-caches/<repo-key>/
  --list-profiles         list available profiles and exit
  --init-profile <name>   scaffold a new profile directory with templates, then exit
  -h, --help              show this help
EOF
}

project=""
profile=""
local_cache=0
list_profiles=0
init_profile=""

while [ $# -gt 0 ]; do
  case "$1" in
    --project)
      if [ $# -lt 2 ]; then
        printf 'podbay: --project requires a value\n' >&2
        exit 2
      fi
      project=$2
      shift 2
      ;;
    --project=*)
      project=${1#--project=}
      shift
      ;;
    --profile)
      if [ $# -lt 2 ]; then
        printf 'podbay: --profile requires a value\n' >&2
        exit 2
      fi
      profile=$2
      shift 2
      ;;
    --profile=*)
      profile=${1#--profile=}
      shift
      ;;
    --local-cache)
      local_cache=1
      shift
      ;;
    --list-profiles)
      list_profiles=1
      shift
      ;;
    --init-profile)
      if [ $# -lt 2 ]; then
        printf 'podbay: --init-profile requires a value\n' >&2
        exit 2
      fi
      init_profile=$2
      shift 2
      ;;
    --init-profile=*)
      init_profile=${1#--init-profile=}
      shift
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      printf 'podbay: unknown option: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/podbay"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/podbay"

if [ -n "$init_profile" ]; then
  mkdir -p "$config_dir/profiles/$init_profile"
  mounts_toml="$config_dir/profiles/$init_profile/mounts.toml"
  volumes_toml="$config_dir/profiles/$init_profile/volumes.toml"
  mise_toml="$config_dir/profiles/$init_profile/mise-global.toml"
  extension_sh="$config_dir/profiles/$init_profile/extension.sh"
  if [ -f "$mounts_toml" ] || [ -f "$volumes_toml" ] || [ -f "$mise_toml" ] || [ -f "$extension_sh" ]; then
    printf 'podbay: profile "%s" already exists, refusing to overwrite\n' "$init_profile" >&2
    exit 1
  fi
  cat > "$mounts_toml" <<'EOF'
# Podbay profile mounts: bind mounts from your host into the container.
# These are best for read-only host files you edit on the host.
#
#   [[mount]]
#   host = "~/.gitconfig"                 # path on YOUR machine (~ is allowed)
#   container = "/home/dev/.gitconfig"    # path inside the container
#   mode = "ro"                           # "ro" (default) or "rw"
#
# mode defaults to "ro". Reach for "rw" only when live-editing that file from
# inside a session is genuinely wanted; normally you edit on the host.
#
# A host path that doesn't exist is skipped with a warning, not an error.
#
# ~/.config/podbay/profiles/common/mounts.toml is always merged in first,
# regardless of --profile, for things that belong to "you" generally
# (e.g. .gitconfig). Put workflow-specific mounts here instead.
#
# WARNING: if you mount a path whose parent directory does not already exist
# in the image with the right ownership, Podman may create that parent as
# root, and the container user will not be able to write there. For any
# directory the container needs to create or write into, use volumes.toml
# instead.

# [[mount]]
# host = "~/.zshrc"
# container = "/home/dev/.zshrc"
# mode = "ro"
EOF
  cat > "$volumes_toml" <<'EOF'
# Podbay profile volumes: named Podman volumes that persist across sessions.
# These are the right choice for tool-owned state: anything the container
# creates, updates, or writes (config dirs, caches, auth files, etc.).
#
#   [[volume]]
#   name = "opencode-config"              # short name for this volume
#   container = "/home/dev/.config/opencode"  # mount point inside the container
#
# The actual volume name will be namespaced as podbay-vol-<profile>-<name>.
# Volumes are created automatically on first use and survive --rm.

# [[volume]]
# name = "opencode-config"
# container = "/home/dev/.config/opencode"

# [[volume]]
# name = "opencode-data"
# container = "/home/dev/.local/share/opencode"
EOF
  cat > "$mise_toml" <<'EOF'
# Podbay profile: personal tools, installed by mise into every session.
# Declared tools are ADDITIVE with whatever the mounted repo asks for
# (mise unions global + project config), so these are always available
# without touching the repo's own config.
#
# [tools]
# opencode = "latest"
# node = "22"
EOF
  cat > "$extension_sh" <<'EOF'
#!/bin/sh
# Podbay profile extension: runs as root while building the per-profile image.
# This is the place for root-level setup that should persist across disposable
# container runs (e.g. installing system libraries that mise cannot provide).
#
# The script is copied to /usr/local/share/podbay/extension.sh in the derived
# image and executed during the build. It is NOT read from the mounted repo.
#
# Example (Chromium / Playwright headless dependencies on Debian trixie):
#
#   apt-get update \
#     && apt-get install -y --no-install-recommends \
#       libx11-6 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 \
#       libasound2t64 libatk1.0-0t64 libatk-bridge2.0-0t64 libatspi2.0-0t64 \
#       libdbus-1-3 libgbm1 libglib2.0-0t64 libnspr4 libnss3 libxcb1 \
#       libxkbcommon0 fonts-liberation \
#     && rm -rf /var/lib/apt/lists/*
EOF
  printf 'podbay: created profile "%s" at %s\n' "$init_profile" "$config_dir/profiles/$init_profile"
  printf 'podbay:   edit mounts.toml, volumes.toml, mise-global.toml, and extension.sh, then:\n'
  printf 'podbay:   ./bin/podbay --project <repo> --profile %s\n' "$init_profile"
  exit 0
fi

if [ "$list_profiles" -eq 1 ]; then
  for dir in "$config_dir/profiles"/*/; do
    [ -d "$dir" ] || continue
    name=$(basename "$dir")
    [ "$name" = "common" ] && continue
    printf '%s\n' "$name"
  done
  exit 0
fi

if [ -z "$project" ]; then
  printf 'podbay: --project is required\n' >&2
  usage >&2
  exit 2
fi

if [ ! -d "$project" ]; then
  printf 'podbay: not a directory: %s\n' "$project" >&2
  exit 1
fi

if [ -n "$profile" ]; then
  profile_dir="$config_dir/profiles/$profile"
  if [ ! -d "$profile_dir" ]; then
    printf 'podbay: profile not found: %s\n' "$profile" >&2
    if [ -d "$config_dir/profiles" ]; then
      printf 'podbay: (available: %s)\n' "$(cd "$config_dir/profiles" && printf '%s ' */ | sed 's#/##g; s#common##; s/  */ /g')" >&2
    fi
    exit 2
  fi
fi

project=$(realpath -m "$project")
repo_key=$(repo_key_for "$project")
printf 'podbay: repo-key %s\n' "$repo_key"

mkdir -p "$config_dir/profiles" "$config_dir/overlays" "$cache_dir"

common_dir="$config_dir/profiles/common"
container_image=$(resolve_profile_image podbay-base:latest "${profile_dir:-}" "$common_dir")
printf 'podbay: using image %s\n' "$container_image"

workspace_dir="/home/dev/workspace/repomount"
mounts=(
  "$project:$workspace_dir:rw"
)
podbay_volume_paths=()

if [ "$local_cache" -eq 1 ]; then
  local_cache_dir="$cache_dir/mise-caches/$repo_key"
  mkdir -p "$local_cache_dir"
  mounts+=("$local_cache_dir:/home/dev/.local/share/mise:rw")
  printf 'podbay: using local cache %s\n' "$local_cache_dir"
else
  if ! podman volume exists podbay-mise-cache >/dev/null 2>&1; then
    podman volume create podbay-mise-cache >/dev/null
  fi
  mounts+=("podbay-mise-cache:/home/dev/.local/share/mise:rw")
fi

load_mounts "$config_dir/profiles/common/mounts.toml"
load_volumes "$config_dir/profiles/common/volumes.toml" "common"

if [ -n "$profile" ]; then
  load_mounts "$profile_dir/mounts.toml"
  load_volumes "$profile_dir/volumes.toml" "$profile"
  if [ -f "$profile_dir/mise-global.toml" ]; then
    mounts+=("$profile_dir/mise-global.toml:/home/dev/.config/mise/config.toml:ro")
  fi
fi

podman_env=(
  "-e" "PODBAY_WORKSPACE=$workspace_dir"
)
if [ ${#podbay_volume_paths[@]} -gt 0 ]; then
  # Colon-separated list of volume mount points; the entrypoint uses this to
  # ensure each path exists and is owned by the container user before handing
  # control to the user command.
  podman_env+=("-e" "PODBAY_VOLUME_PATHS=$(IFS=:; printf '%s' "${podbay_volume_paths[*]}")")
fi

exec podman run --rm -it --userns=keep-id "${podman_env[@]}" "${mounts[@]/#/-v}" "$container_image"
