#!/bin/sh
# Stand-in for mise in the test image. `mise install` records what the
# provisioning container could see and reach, in the mise data directory.
set -e
if [ "$1" != install ]; then
  echo "test mise: only install is supported" >&2
  exit 2
fi
data=${MISE_DATA_DIR:-$HOME/.local/share/mise}
if touch .podbay-probe 2>/dev/null; then
  rm -f .podbay-probe
  project="writable"
else
  project="readonly"
fi
{
  # shellcheck disable=SC2012 # interface names are plain
  echo "network=$(ls /sys/class/net | tr '\n' ' ')"
  echo "project=$project"
  echo "tools=$(tr '\n' ' ' 2>/dev/null < ~/.config/mise/config.toml)"
  echo "versions=$(cat .tool-versions 2>/dev/null)"
} > "$data/provisioned"
echo x >> "$data/installs"
