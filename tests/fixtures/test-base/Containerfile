# Minimal stand-in for the bundled base image: the same dev user layout,
# without the network-heavy toolchain, and a fake installer that records
# what provisioning saw. Used by the end-to-end tests via the `base_image`
# config setting; podbay adds podbay-init on top, as it does to any image.
FROM debian:trixie-slim@sha256:f6b08b09a05725f9431502d3b5714f5c4576e82c1a84fa1debe0c24a7e0c3ec4
RUN useradd -m -u 1000 -U -s /bin/bash dev \
  && mkdir -p /home/dev/workspace \
  && chown -R dev:dev /home/dev \
  && mkdir -p /usr/local/share/podbay \
  && cp -a /home/dev /usr/local/share/podbay/home
COPY probe-install /usr/local/bin/probe-install
RUN chmod +x /usr/local/bin/probe-install
WORKDIR /home/dev/workspace
CMD ["bash", "-l"]
