# podbay's bundled base: Debian with the usual build tools and a dev user.
# podbay adds podbay-init and the login-shell PATH snippet on top, as it
# does to any image (see LayerSource::Adapter in src/image.rs).
FROM debian:trixie-slim

# Deliberately not pinned: every build of this image starts from the
# current trixie-slim and Debian's current packages, security updates
# included, so a rebuild is how it gets patched. podbay builds it without
# the build cache and pulls the image above each time (see `refresh` in
# src/image.rs). apt checks Debian's signatures on everything it installs.
RUN apt-get update \
  && apt-get upgrade -y \
  && apt-get install -y --no-install-recommends \
    ca-certificates git curl unzip xz-utils tar build-essential \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -U -s /bin/bash dev \
  && mkdir -p /home/dev/workspace \
  && chown -R dev:dev /home/dev \
  && mkdir -p /usr/local/share/podbay \
  && cp -a /home/dev /usr/local/share/podbay/home

WORKDIR /home/dev/workspace
CMD ["bash", "-l"]
