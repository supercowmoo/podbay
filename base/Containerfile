FROM debian:trixie-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates git curl unzip tar zsh build-essential gosu gnupg \
  && rm -rf /var/lib/apt/lists/*

RUN curl -fsSL https://keys.openpgp.org/vks/v1/by-fingerprint/24853EC9F655CE80B48E6C3A8B81C9D17413A06D -o /tmp/mise.asc \
  && gpg --batch --import /tmp/mise.asc \
  && gpg --batch --fingerprint 24853EC9F655CE80B48E6C3A8B81C9D17413A06D >/dev/null \
  && curl -fsSL https://mise.jdx.dev/install.sh.sig -o /tmp/mise-install.sig \
  && gpg --batch --decrypt /tmp/mise-install.sig > /tmp/mise-install.sh \
  && MISE_VERSION=v2026.8.14 MISE_INSTALL_PATH=/usr/local/bin/mise sh /tmp/mise-install.sh \
  && rm -f /tmp/mise.asc /tmp/mise-install.sig /tmp/mise-install.sh

RUN useradd -m -u 1000 -U -s /usr/bin/zsh dev \
  && mkdir -p /workspace \
    /home/dev/.config/mise \
    /home/dev/.local/share/mise \
    /home/dev/.local/state/mise \
  && chown -R dev:dev /home/dev

RUN printf '\neval "$(mise activate zsh)"\n' >> /etc/zsh/zshrc

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["zsh", "-l"]
