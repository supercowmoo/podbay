# podbay-init, the container's first process: a static binary built from
# init/src/main.rs with plain rustc, so it needs nothing from this image.
FROM rust:1.90.0-alpine3.22 AS init
COPY init.rs /src/init.rs
RUN rustc --edition 2024 -C opt-level=s -C panic=abort \
    -C target-feature=+crt-static -C strip=symbols -o /podbay-init /src/init.rs

FROM debian:trixie-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates git curl unzip xz-utils tar build-essential \
  && rm -rf /var/lib/apt/lists/*

RUN useradd -m -u 1000 -U -s /bin/bash dev \
  && mkdir -p /home/dev/workspace \
  && chown -R dev:dev /home/dev \
  && mkdir -p /usr/local/share/podbay \
  && cp -a /home/dev /usr/local/share/podbay/home

# Login shells reset PATH from /etc/profile; put the profile's `path`
# entries (PODBAY_PATH) back in front.
RUN printf '%s\n' \
    'if [ -n "${PODBAY_PATH:-}" ]; then' \
    '  case ":$PATH:" in *":$PODBAY_PATH:"*) ;; *) PATH="$PODBAY_PATH:$PATH" ;; esac' \
    '  export PATH' \
    'fi' > /etc/profile.d/podbay-path.sh

COPY --from=init /podbay-init /usr/local/bin/podbay-init

WORKDIR /home/dev/workspace
ENTRYPOINT ["/usr/local/bin/podbay-init"]
CMD ["bash", "-l"]
